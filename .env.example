# JurisTwin local environment template.
# Recommended: run `python tools/bootstrap_env.py` (or setup_windows.bat) to create .env with
# independent cryptographically random signing secrets. Do not commit the generated .env.

SECRET_KEY=replace-with-random-jwt-secret
WEBHOOK_SECRET=replace-with-independent-random-webhook-secret
PROOF_SIGNING_SECRET=replace-with-independent-random-proof-signing-secret
POSTGRES_PASSWORD=replace-with-random-postgresql-password
DEMO_PASSWORD=Finals2026!
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Finals-safe default: leave DATABASE_URL unset for SQLite.
# Optional pilot PostgreSQL mode:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/juristwin
