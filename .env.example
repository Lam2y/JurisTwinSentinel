# JurisTwin Sentinel — Mastery UI Finals Edition v11
# Copy to .env for local use. Never commit real production secrets.
SECRET_KEY=replace-with-a-long-random-secret-at-least-48-characters
EXPORT_ENCRYPTION_KEY=use-a-separate-long-random-key-or-managed-KMS-secret
INTEGRATION_API_KEY=replace-with-a-scoped-system-to-system-api-key
DEMO_PASSWORD=Finals2026!
DEMO_MODE=true
ENVIRONMENT=demo
ACCESS_TOKEN_MINUTES=240

# Demo runs on loopback HTTP. In deployment, terminate TLS at a trusted reverse proxy
# and set REQUIRE_HTTPS=true so the application fails closed on non-HTTPS requests.
REQUIRE_HTTPS=false
TRANSFER_MAX_CLOCK_SKEW_SECONDS=300

# Demo default is SQLite. For deployment, point this to PostgreSQL without changing business logic.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/juristwin
# DATABASE_URL=sqlite:///./backend/juristwin_mastery.db

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DOMAIN_CONFIDENCE_THRESHOLD=0.56
EVIDENCE_COVERAGE_THRESHOLD=0.10
GROUP_CHAT_RELEVANCE_THRESHOLD=0.55
PATTERN_MATCH_THRESHOLD=0.62
MAX_QUESTION_LENGTH=1200
MAX_REQUEST_BYTES=1048576
RESOLVED_GAP_RETENTION_DAYS=30
